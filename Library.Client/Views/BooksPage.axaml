<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Library.Client.ViewModels"
             x:DataType="vm:BooksViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Library.Client.Views.BooksPage">
     <StackPanel Orientation="Vertical" Margin="20" Spacing="14">

        <!-- Заголовок -->
        <TextBlock Text="Список книг" FontSize="20" FontWeight="SemiBold"/>

        <!-- Кнопки действий -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Взять"
                    Classes="accent"
                    Padding="16,7"
                    CornerRadius="6"/>

            <Button Content="Положить"
                    Padding="16,7"
                    CornerRadius="6"/>

            <Button Content="Карточка"
                    Command="{Binding OpenBookCardCommand}"
                    Padding="16,7"
                    CornerRadius="6"/>

            <Button Content="Добавить книгу"
                    IsVisible="{Binding IsAdmin}"
                    Command="{Binding OpenAddBookCommand}"
                    Padding="16,7"
                    CornerRadius="6"/>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid ItemsSource="{Binding Books}"
                  SelectedItem="{Binding SelectedBook}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  Height="390"
                  BorderThickness="1"
                  BorderBrush="#40808080"
                  CornerRadius="6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="130" />
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="1.5*" />
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="*" />
                <DataGridTextColumn Header="Год издания" Binding="{Binding Year}" Width="100" />
                <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="100" />
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

    </StackPanel>

  
</UserControl>
