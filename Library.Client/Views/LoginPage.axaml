<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Library.Client.ViewModels"
             x:DataType="vm:LoginPageViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Library.Client.Views.LoginPage">
    
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
            <Label HorizontalAlignment="Center">Вход</Label>
            <Label  HorizontalAlignment="Center">Войдите в систему</Label>
            <TextBox  Text="{Binding Login}"  Margin="0,10"></TextBox>
            <TextBox PasswordChar="*" Text="{Binding Password}" ></TextBox>
            <TextBlock IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding ErrorMessage}" HorizontalAlignment="Center" ></TextBlock>
            <Button  Width="300" HorizontalAlignment="Center"  Content="Войти"   Margin="0,10"
                      Command="{Binding LoginCommand}"></Button>
            <Button Width="300" HorizontalAlignment="Center"  Content="Регистрация" 
                     Command="{Binding GoToRegisterCommand}"></Button>
        </StackPanel>
    
</UserControl>
